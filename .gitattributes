* text=auto

# PowerShell erwartet unter Windows CRLF.
*.ps1  text eol=crlf
*.psd1 text eol=crlf
*.yaml text eol=crlf
*.md   text eol=crlf

# Vorlagen wie repo.yaml.example werden im Editor geoeffnet.
*.example text eol=crlf

VERSION text eol=lf

# cmd.exe braucht CRLF, sonst stolpert es ueber Zeilenenden.
*.cmd  text eol=crlf
